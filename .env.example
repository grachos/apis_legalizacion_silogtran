# Silogtran
SILOG_BASE_URL=https://construproyec.colombiasoftware.net
SILOG_USER=
SILOG_PASSWORD=
# Optional: cost center (option value or text). Default = CONSTRUPROYEC-PRINCIPAL (partial match), else first.
# SILOG_COST_CENTER=CONSTRUPROYEC-PRINCIPAL

# Static key required in the x-api-key header. Generate: openssl rand -hex 32
API_KEY=

# AWS WAF (Docker image sets WAF_CHROME_PATH=/usr/bin/chromium)
# WAF_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# WAF_WAIT_SEC=30
# SILOG_TIMEOUT_SEC=120
# MAX_RANGE_DAYS=731
# CACHE_TTL_HOURS=24
# CACHE_MAX_ROWS=250000
PORT=3000

# Persistent cache (optional) - Supabase project URL + secret/service_role key (server only)
# SUPABASE_URL=https://nexczcdmwysulvvxldlf.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_CACHE_RETENTION_DAYS=30
