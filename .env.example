# AWS WAF (Docker image sets WAF_CHROME_PATH=/usr/bin/chromium)
# WAF_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# WAF_WAIT_SEC=30
# SILOG_TIMEOUT_SEC=120
# MAX_RANGE_DAYS=366
PORT=3000
